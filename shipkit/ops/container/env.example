# Copy outside the Git checkout, for example /srv/shipkit/config/deploy.env.
# This file contains deployment references only. Never place tokens or keys here.
SHIPKIT_IMAGE=registry.example.com/shipkit/server@sha256:REPLACE_WITH_RELEASE_DIGEST
