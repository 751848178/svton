# Replace the domain and existing certificate/key references.
# Only the Web endpoint is exposed; the Web app proxies its own /api requests.
# Place this file in the nginx http context. Client IP comes from the TCP peer.
limit_req_zone $binary_remote_addr zone=shipkit_login:10m rate=1r/m;
server {
    listen 80;
    server_name SHIPKIT_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name SHIPKIT_DOMAIN;
    ssl_certificate /ABSOLUTE/TLS/fullchain.pem;
    ssl_certificate_key /ABSOLUTE/TLS/privkey.pem;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 90s;

    location = /api/auth/login {
        limit_req zone=shipkit_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8769;
    }

    location / {
        proxy_pass http://127.0.0.1:8769;
    }
}
