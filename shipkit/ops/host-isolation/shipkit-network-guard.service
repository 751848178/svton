[Unit]
Description=Shipkit scoped private network guard
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/shipkit-isolation/control.env
ExecStart=/usr/bin/python3 /usr/local/lib/shipkit-host-isolation/guard.py apply --pre-daemon

[Install]
WantedBy=multi-user.target
