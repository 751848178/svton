# Root-owned 0600 /etc/shipkit-isolation/agent.env; populate outside the repository.
SHIPKIT_AGENT_NODE=/opt/shipkit-agent/releases/RELEASE/node/bin/node
SHIPKIT_AGENT_ENTRY=/opt/shipkit-agent/releases/RELEASE/dist/agent/server.js
SHIP_AGENT_ROLE=runtime
SHIP_AGENT_TOKEN=REPLACE_WITH_INDEPENDENT_PRIVATE_TOKEN
SHIP_WORK_ROOT=/srv/shipkit-agent
HOME=/srv/shipkit-agent
