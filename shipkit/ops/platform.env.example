# Private EnvironmentFile: root/service owner only, chmod 600.
# systemd does not expand shell variables in this file; use literal absolute paths.
NODE_ENV=production
PATH=/ABSOLUTE/NODE/BIN:/ABSOLUTE/PNPM/BIN:/usr/local/bin:/usr/bin:/bin
SHIPKIT_DATA_DIR=/ABSOLUTE/DATA/DIRECTORY
DATABASE_URL=file:/ABSOLUTE/DATA/DIRECTORY/platform.db
SHIPKIT_PUBLIC_ORIGIN=https://SHIPKIT_DOMAIN
SHIPKIT_SECRET_KEY_FILE=/ABSOLUTE/PRIVATE/KEY/DIRECTORY/key.json
# Git metadata on platform; full checkout on Builder. Configure both hosts.
SHIPKIT_GIT_ALLOWED_HOSTS=github.com,gitlab.com
# Self-hosted Git only: list exact approved hosts resolving to private addresses.
# SHIPKIT_GIT_ALLOW_PRIVATE_HOSTS=git.internal.example
# Configure login bootstrap and Agent/cloud credentials through separately
# documented private references. Never place real secrets in this example.
