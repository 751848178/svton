# Version control
.git

# Dependencies & host build outputs
# API dist remains available to its image; Web is compiled inside its image.
**/node_modules
**/.next
**/.turbo
.turbo
out
coverage

# Local secrets & env files (mounted at runtime instead)
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Repo-only tooling / heavy dirs
.codegraph
.skills
apps/agent-web/public/skills

# Logs & OS noise
**/*.log
**/.DS_Store

# Compose files are not needed inside images
docker-compose*.yml
