{
  "name": "@svton/shipkit-api",
  "version": "0.1.0",
  "private": true,
  "prisma": { "schema": "prisma/schema" },
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/migrate.mjs",
    "auth:admin": "node --import tsx src/auth/admin-cli.ts",
    "secret:init": "node --import tsx src/secrets/key-init.cli.ts init",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@prisma/client": "5.22.0",
    "@svton/nestjs-http": "workspace:*",
    "express": "4.22.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "shipkit": "workspace:*",
    "@svton/authz": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "prisma": "5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
