generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Workspace {
  id String @id
  name String
  projects Project[]
  audits Audit[]
}
model Actor {
  id String @id
  kind String
  name String
  username String? @unique
  passwordHash String?
  disabled Boolean @default(false)
  sessions AuthSession[]
  createdProjects Project[]
  plans Plan[]
  tasks Task[]
  audits Audit[]
}
model AuthSession {
  id String @id
  actorId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([actorId])
}
model Project {
  id String @id @default(cuid())
  workspaceId String
  name String
  rootPath String
  configPath String
  targetKey String
  projectIdentity String
  lastVersion String @default("0.0.0")
  createdByActorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy Actor @relation(fields: [createdByActorId], references: [id], onDelete: Restrict)
  targets Target[]
  services Service[]
  plans Plan[]
  tasks Task[]
  @@unique([workspaceId, rootPath])
}
model Target {
  id String @id @default(cuid())
  projectId String
  targetKey String
  displayName String?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, targetKey])
}
model Service {
  id String @id @default(cuid())
  projectId String
  serviceKey String
  displayName String?
  entryUrl String?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, serviceKey])
}
model Plan {
  id String @id @default(cuid())
  projectId String
  kind String
  version String?
  targetKey String
  baseReleaseId String?
  selectionJson String
  snapshotJson String
  fingerprint String
  actorId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Restrict)
  tasks Task[]
  @@index([projectId, createdAt])
}
model Task {
  id String @id @default(cuid())
  projectId String
  planId String
  kind String
  version String
  status String @default("queued")
  phase String @default("provision")
  cancelState String @default("none")
  recoveryState String @default("none")
  cleanupState String @default("pending")
  activeScope String? @unique
  idempotencyKey String? @unique
  actorId String
  remoteReleaseId String?
  previousReleaseId String?
  error String?
  outputJson String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Restrict)
  stages Stage[]
  remoteJobs RemoteJob[]
  events Event[]
  logs LogArchive[]
  leases ResourceLease[]
  @@index([projectId, createdAt])
  @@unique([projectId, version])
}
model Stage {
  id String @id @default(cuid())
  taskId String
  stageKey String
  serviceKey String @default("")
  attempt Int @default(1)
  status String @default("pending")
  detailJson String?
  updatedAt DateTime @updatedAt
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, stageKey, serviceKey, attempt])
}
model RemoteJob {
  id String @id @default(cuid())
  taskId String
  stageKey String
  serviceKey String @default("")
  agentRole String
  urlRef String
  jobId String
  status String
  logOffset Int @default(0)
  eventOffset Int @default(0)
  updatedAt DateTime @updatedAt
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, urlRef, jobId])
}
model Event {
  id String @id @default(cuid())
  taskId String
  seq Int
  type String
  stageKey String?
  serviceKey String?
  payloadJson String
  createdAt DateTime @default(now())
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, seq])
}
model LogArchive {
  id String @id @default(cuid())
  taskId String
  stageKey String
  serviceKey String @default("")
  relativePath String
  bytes Int @default(0)
  complete Boolean @default(false)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, stageKey, serviceKey])
}
model ResourceLease {
  id String @id @default(cuid())
  taskId String
  provider String
  leaseRef String
  status String
  detailJson String?
  updatedAt DateTime @updatedAt
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, provider, leaseRef])
}
model Audit {
  id String @id @default(cuid())
  workspaceId String
  actorId String
  requestId String
  action String
  resourceType String
  resourceId String
  outcome String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([workspaceId, createdAt])
}
