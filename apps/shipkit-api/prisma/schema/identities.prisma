model Workspace {
  id String @id
  name String
  projects Project[]
  audits Audit[]
  agents Agent[]
  agentEnrollments AgentEnrollment[]
}

model Actor {
  id String @id
  kind String
  name String
  username String? @unique
  passwordHash String?
  disabled Boolean @default(false)
  sessions AuthSession[]
  createdProjects Project[]
  plans Plan[]
  tasks Task[]
  audits Audit[]
  configDrafts ConfigDraft[]
  configVersions ConfigVersion[]
  machineAgent Agent? @relation("AgentActor")
  issuedAgentEnrollments AgentEnrollment[] @relation("AgentEnrollmentIssuer")
}

model AuthSession {
  id String @id
  actorId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([actorId])
}
