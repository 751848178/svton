  teamId            String
  streamId          String?
  actorId           String?
  projectId         String?
  environmentId     String?
  dryRun            Boolean  @default(true)
  retentionDays     Int
  cutoffAt          DateTime
  matchedEntryCount Int      @default(0)
  deletedEntryCount Int      @default(0)
  status            String   @default("running") // running | completed | failed
  error             String?  @db.Text
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  createdAt         DateTime @default(now())

  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stream            LogStream? @relation(fields: [streamId], references: [id], onDelete: SetNull)
  actor             User?    @relation("LogRetentionRunActor", fields: [actorId], references: [id], onDelete: SetNull)
  auditEvents       AuditEvent[]

  @@index([teamId])
  @@index([streamId])
  @@index([actorId])
  @@index([projectId])
  @@index([environmentId])
  @@index([dryRun])
  @@index([status])
  @@index([cutoffAt])
  @@index([startedAt])
}

// 操作审批
model OperationApproval {
  id                   String   @id @default(cuid())
  teamId               String
  requesterId          String?
  reviewerId           String?
  projectId            String?
  environmentId        String?
  applicationId        String?
  applicationServiceId String?
  serverId             String?
  siteId               String?
  managedResourceId    String?
  category             String   // resource_action | service_operation | deployment
  action               String
  targetType           String
  targetId             String?
  risk                 String   @default("medium") // low | medium | high
  status               String   @default("pending") // pending | approved | rejected | cancelled
  summary              String?  @db.Text
  reason               String?  @db.Text
  reviewComment        String?  @db.Text
  inputHash            String?  // 审批绑定的输入快照哈希；配置变化后旧审批失效
  metadata             Json?
  requestedAt          DateTime @default(now())
  reviewedAt           DateTime?
  consumedAt           DateTime?
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  team                 Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requester            User?    @relation("OperationApprovalRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  reviewer             User?    @relation("OperationApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  project              Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  environment          ProjectEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  application          Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationService   ApplicationService? @relation(fields: [applicationServiceId], references: [id], onDelete: SetNull)
  server               Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  site                 Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  managedResource      ManagedResource? @relation(fields: [managedResourceId], references: [id], onDelete: SetNull)
  siteSyncRuns         SiteSyncRun[]
  resourceActionRuns   ResourceActionRun[]
  applicationServiceOperationRuns ApplicationServiceOperationRun[]
  deploymentRuns       DeploymentRun[]
  auditEvents          AuditEvent[]
  releaseStageAttempts ReleaseStageAttempt[] @relation("OperationApprovalReleaseAttempt")
  releaseRuns          ReleaseRun[]

  @@index([teamId])
  @@index([requesterId])
  @@index([reviewerId])
  @@index([projectId])
  @@index([environmentId])
  @@index([applicationId])
  @@index([applicationServiceId])
  @@index([serverId])
  @@index([siteId])
  @@index([managedResourceId])
  @@index([category])
  @@index([action])
  @@index([targetType])
  @@index([targetId])
  @@index([risk])
  @@index([status])
  @@index([requestedAt])
  @@index([reviewedAt])
  @@index([consumedAt])
  @@index([inputHash])
}
