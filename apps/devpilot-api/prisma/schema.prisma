// 发布单：用户可见的一次版本交付工作流；执行细节由 BuildRun/ReleaseRun 和 legacy ReleasePlan 承载
model ReleaseOrder {
  id             String   @id @default(cuid())
  teamId         String
  projectId      String
  releaseVersion String
  note           String?  @db.Text
  status         String   @default("draft") // draft | active | succeeded | failed | canceled
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User?    @relation("ReleaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  buildRuns      BuildRun[]
  manifests      ArtifactManifest[]
  releaseRuns    ReleaseRun[]
  environmentVersions EnvironmentVersion[]
  legacyPlans    ReleasePlan[]
  gateEvaluations GateEvaluation[]
  gateDecisions ReleaseGateDecision[]
  gateManualApprovals GateManualApproval[]
  productionPromotionCommands ProductionPromotionCommand[]
  productionPromotionReconcileCommands ProductionPromotionReconcileCommand[]

  @@unique([projectId, releaseVersion])
  @@index([teamId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

// 一次固定分支与 Commit 的不可变构建执行
model BuildRun {
  id             String   @id @default(cuid())
  teamId         String
  projectId      String
  releaseOrderId String
  triggeredById  String?
  repositoryIdentityId String?
  repositoryIdentityRevisionId String?
  revision       Int
  sourceBranch   String
  sourceCommitSha String
  inputSnapshot  Json
  inputHash      String
  status         String   @default("queued") // queued | running | succeeded | failed | canceled
  logReference   String?
  logSummary     Json?
  gateSummary    Json?
  errorCode      String?
  errorMessage   String?  @db.Text
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseOrder   ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  triggeredBy    User?    @relation("BuildRunActor", fields: [triggeredById], references: [id], onDelete: SetNull)
  repositoryIdentity ProjectRepositoryIdentity? @relation(fields: [repositoryIdentityId], references: [id], onDelete: Restrict)
  repositoryIdentityRevision ProjectRepositoryIdentityRevision? @relation(fields: [repositoryIdentityRevisionId], references: [id], onDelete: Restrict)
  manifest       ArtifactManifest?
  stageAttempt   ReleaseStageAttempt?
  gateEvaluations GateEvaluation[]

  @@unique([releaseOrderId, revision])
  @@index([teamId])
  @@index([projectId])
  @@index([triggeredById])
  @@index([repositoryIdentityId])
  @@index([repositoryIdentityRevisionId])
  @@index([sourceCommitSha])
  @@index([status])
  @@index([createdAt])
}

// 成功 BuildRun 产生的不可变制品清单；同一 digest 可来自不同 BuildRun
model ArtifactManifest {
  id             String   @id @default(cuid())
  teamId         String
  projectId      String
  releaseOrderId String
  buildRunId     String   @unique
  digest         String
  provenance     Json?
  sbom           Json?
  signature      Json?
  createdAt      DateTime @default(now())

  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseOrder   ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  buildRun       BuildRun @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  items          ArtifactManifestItem[]
  deploymentRuns DeploymentRun[]
  releaseRuns    ReleaseRun[]
  environmentVersions EnvironmentVersion[]

  @@index([teamId])
  @@index([projectId, digest])
  @@index([releaseOrderId])
  @@index([createdAt])
}

model ArtifactManifestItem {
  id           String   @id @default(cuid())
  manifestId   String
  componentKey String
  artifactType String
  uri          String   @db.Text
  digest       String
  metadata     Json?
  createdAt    DateTime @default(now())

  manifest     ArtifactManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@unique([manifestId, componentKey])
  @@index([digest])
}

// 生产确认、升级或恢复的冻结运行边界
model ReleaseRun {
  id                    String   @id @default(cuid())
  teamId                String
  projectId             String
  releaseOrderId        String
  environmentId         String
  artifactManifestId    String
  releasePlanId         String?
  configRevisionId      String?
  releasePolicyRevisionId String?
  operationApprovalId   String?
  sourceReleaseRunId    String?
  actorId               String?
  mode                  String   @default("standard") // standard | upgrade | recovery
  status                String   @default("pending") // pending | awaiting_approval | running | awaiting_validation | succeeded | failed | canceled
  verifiedDigest        String
  resourceSnapshot      Json?
  routeSnapshot         Json?
  policySnapshot        Json?
  inputHash             String
  idempotencyKey        String
  errorCode             String?
  errorMessage          String?  @db.Text
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  team                  Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseOrder          ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  environment           ProjectEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  artifactManifest      ArtifactManifest @relation(fields: [artifactManifestId], references: [id], onDelete: Restrict)
  releasePlan           ReleasePlan? @relation(fields: [releasePlanId], references: [id], onDelete: SetNull)
  configRevision        EnvironmentConfigRevision? @relation(fields: [configRevisionId], references: [id], onDelete: SetNull)
  releasePolicyRevision ReleasePolicyRevision? @relation(fields: [releasePolicyRevisionId], references: [id], onDelete: SetNull)
  operationApproval     OperationApproval? @relation(fields: [operationApprovalId], references: [id], onDelete: SetNull)
  sourceReleaseRun      ReleaseRun? @relation("ReleaseRunSource", fields: [sourceReleaseRunId], references: [id], onDelete: SetNull)
  derivedReleaseRuns    ReleaseRun[] @relation("ReleaseRunSource")
  actor                 User?    @relation("ReleaseRunActor", fields: [actorId], references: [id], onDelete: SetNull)
  deploymentRuns        DeploymentRun[]
  environmentVersion    EnvironmentVersion?
  stageAttempt          ReleaseStageAttempt?
  gateEvaluations       GateEvaluation[]
  siteRouteSwitchRuns   SiteRouteSwitchRun[]
  productionPromotionCommands ProductionPromotionCommand[]
  productionPromotionReconcileCommands ProductionPromotionReconcileCommand[]

  @@unique([releaseOrderId, idempotencyKey])
  @@index([teamId])
  @@index([projectId])
  @@index([environmentId])
  @@index([artifactManifestId])
  @@index([releasePlanId])
  @@index([releasePolicyRevisionId])
  @@index([configRevisionId])
  @@index([operationApprovalId])
  @@index([sourceReleaseRunId])
  @@index([actorId])
  @@index([status])
  @@index([createdAt])
}

// Production provider deploy 后，按精确候选继续 promotion 的幂等命令。
// GateEvaluation/ReleaseGateDecision 仍是独立的追加式评估历史。
model ProductionPromotionCommand {
  id              String   @id @default(cuid())
  teamId          String
  projectId       String
  releaseOrderId  String
  releaseRunId    String
  deploymentRunId String
  actorId         String
  idempotencyKey  String
  candidateHash   String
  inputHash       String
  status          String   @default("running") // running | completed | failed | blocked
  phase           String   @default("reserved") // reserved | pre_gate_allowed | route_switched | observed | post_gate_allowed | committing
  leaseOwner      String?
  leaseTokenHash  String?
  leaseExpiresAt  DateTime?
  heartbeatAt     DateTime?
  attemptCount    Int      @default(0)
  preDecisionId   String?
  preDecisionInputHash String?
  preDecisionActionHash String?
  postDecisionId  String?
  postDecisionInputHash String?
  postDecisionActionHash String?
  routeSwitchOperationId String?
  observationRecordedAt DateTime?
  legacyReconcileRequired Boolean @default(false)
  legacyReconcileReason String?
  result          Json?
  errorCode       String?
  errorMessage    String?  @db.Text
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseOrder    ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  releaseRun      ReleaseRun @relation(fields: [releaseRunId], references: [id], onDelete: Cascade)
  deploymentRun   DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  actor           User     @relation("ProductionPromotionCommandActor", fields: [actorId], references: [id], onDelete: Restrict)
  reconcileCommands ProductionPromotionReconcileCommand[]

  @@unique([deploymentRunId, idempotencyKey])
  @@index([teamId])
  @@index([projectId])
  @@index([releaseOrderId])
  @@index([releaseRunId])
  @@index([actorId])
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([leaseOwner])
  @@index([routeSwitchOperationId])
  @@index([legacyReconcileRequired, status])
  @@index([createdAt])
}

// 对无法证明历史阶段的 Production promotion 进行显式、追加式人工核对。
model ProductionPromotionReconcileCommand {
  id                 String   @id @default(cuid())
  teamId             String
  projectId          String
  releaseOrderId     String
  releaseRunId       String
  deploymentRunId    String
  promotionCommandId String
  actorId            String
  idempotencyKey     String
  inputHash          String
  status             String   @default("running") // running | completed | blocked
  readbackState      String?
  routeSwitchOperationId String?
  routeProviderKey   String?
  result             Json?
  errorCode          String?
  errorMessage       String?  @db.Text
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseOrder       ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  releaseRun         ReleaseRun @relation(fields: [releaseRunId], references: [id], onDelete: Cascade)
  deploymentRun      DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  promotionCommand   ProductionPromotionCommand @relation(fields: [promotionCommandId], references: [id], onDelete: Cascade)
  actor              User @relation("ProductionPromotionReconcileCommandActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([promotionCommandId, idempotencyKey])
  @@index([teamId])
  @@index([projectId])
  @@index([releaseOrderId])
  @@index([releaseRunId])
  @@index([deploymentRunId])
  @@index([actorId])
  @@index([status])
  @@index([createdAt])
}

// 成功 DeploymentRun 派生的不可变环境当前/历史版本
model EnvironmentVersion {
  id                 String   @id @default(cuid())
  teamId             String
  projectId          String
  environmentId      String
  releaseOrderId     String
  artifactManifestId String
  deploymentRunId    String   @unique
  releaseRunId       String?  @unique
  previousVersionId  String?
  kind               String   @default("deploy") // deploy | upgrade | recovery
  effectiveAt        DateTime
  createdAt          DateTime @default(now())

  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment        ProjectEnvironment @relation("EnvironmentVersionHistory", fields: [environmentId], references: [id], onDelete: Cascade)
  releaseOrder       ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  artifactManifest   ArtifactManifest @relation(fields: [artifactManifestId], references: [id], onDelete: Restrict)
  deploymentRun      DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Restrict)
  releaseRun         ReleaseRun? @relation(fields: [releaseRunId], references: [id], onDelete: SetNull)
  previousVersion    EnvironmentVersion? @relation("EnvironmentVersionHistoryChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions       EnvironmentVersion[] @relation("EnvironmentVersionHistoryChain")
  currentForEnvironment ProjectEnvironment? @relation("CurrentEnvironmentVersion")

  @@index([teamId])
  @@index([projectId])
  @@index([environmentId, effectiveAt])
  @@index([releaseOrderId])
  @@index([artifactManifestId])
  @@index([previousVersionId])
}

// 某一发布对象上的追加式门禁结论；相同证据输入幂等复用，证据变化时追加新行
model GateEvaluation {
  id                String   @id @default(cuid())
  teamId            String
  projectId         String
  releaseOrderId    String
  releaseRunId      String?
  buildRunId        String?
  actorId           String?
  gateId            String
  definitionVersion String
  status            String   // pending | running | passed | warning | failed | skipped | unavailable | needs_human
  providerKey       String?
  reasonCode        String
  summary           Json?
  evidenceRef       String?  @db.Text
  checkedAt         DateTime?
  expiresAt         DateTime?
  sourceSystem      String
  waiver            Json?
  waiverExpiresAt   DateTime?
  inputHash         String
  createdAt         DateTime @default(now())

  team              Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseOrder      ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  releaseRun        ReleaseRun?  @relation(fields: [releaseRunId], references: [id], onDelete: SetNull)
  buildRun          BuildRun?    @relation(fields: [buildRunId], references: [id], onDelete: SetNull)
  actor             User?        @relation("GateEvaluationActor", fields: [actorId], references: [id], onDelete: SetNull)
  manualApprovals   GateManualApproval[]

  @@unique([releaseOrderId, gateId, inputHash])
  @@index([teamId])
  @@index([projectId])
  @@index([releaseRunId])
  @@index([buildRunId])
  @@index([actorId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

// 追加式人工确认；每次确认绑定精确门禁、动作、请求人和冻结源码策略。
model GateManualApproval {
  id                       String   @id @default(cuid())
  teamId                   String
  projectId                String
  releaseOrderId           String
  gateEvaluationId         String
  evaluationInputHash      String
  approvalSubjectHash      String?
  actionInputHash          String
  requesterActorId         String
  reviewerActorId          String
  sourcePolicyRevisionId   String?
  sourcePolicySnapshotHash String?
  sourceCommitSha          String?
  reason                   String   @db.Text
  confirmedAt              DateTime @default(now())
  expiresAt                DateTime?
  createdAt                DateTime @default(now())

  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseOrder         ReleaseOrder          @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  gateEvaluation       GateEvaluation        @relation(fields: [gateEvaluationId], references: [id], onDelete: Cascade)
  sourcePolicyRevision SourcePolicyRevision? @relation(fields: [sourcePolicyRevisionId], references: [id], onDelete: SetNull)
  requester            User                  @relation("GateManualApprovalRequester", fields: [requesterActorId], references: [id], onDelete: Restrict)
  reviewer             User                  @relation("GateManualApprovalReviewer", fields: [reviewerActorId], references: [id], onDelete: Restrict)

  @@unique([gateEvaluationId, evaluationInputHash, actionInputHash, reviewerActorId])
  @@unique([gateEvaluationId, evaluationInputHash, approvalSubjectHash, reviewerActorId])
  @@index([teamId])
  @@index([projectId])
  @@index([releaseOrderId])
  @@index([sourcePolicyRevisionId])
  @@index([actionInputHash])
  @@index([approvalSubjectHash])
  @@index([releaseOrderId, approvalSubjectHash, requesterActorId])
  @@index([expiresAt])
  @@index([createdAt])
}

// Build/Staging/Production 写边界消费的追加式聚合决定与精确门禁输入快照
model ReleaseGateDecision {
  id                     String   @id @default(cuid())
  teamId                 String
  projectId              String
  releaseOrderId         String
  actorId                String?
  stage                  String // build | staging | production
  phase                  String // commit | build | deploy
  allowed                Boolean
  definitionVersion      String
  inputHash              String
  requestKey             String?
  inputSnapshot          Json
  blockerGateIds         Json
  manualGateIds          Json
  confirmedManualGateIds Json
  warningGateIds         Json
  deferredGateIds        Json
  evidenceOnlyGateIds    Json
  integrityErrors        Json
  actionRunType          String?
  actionRunId            String?
  consumedAt             DateTime?
  createdAt              DateTime @default(now())

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseOrder ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ReleaseGateDecisionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([releaseOrderId, stage, requestKey])
  @@index([releaseOrderId, stage, inputHash])
  @@index([actionRunType, actionRunId])
  @@index([teamId])
  @@index([projectId])
  @@index([actorId])
  @@index([stage, allowed])
  @@index([createdAt])
}

// 项目级发布计划（F383）：一次项目+环境+版本的发布不可变快照
model ReleasePlan {
  id              String   @id @default(cuid())
  teamId          String
  projectId       String
  environmentId   String
  name            String
  branch          String?
  commitSha       String?
  source          String   @default("manual") // manual | api | webhook
  trigger         String   @default("manual") // manual | api | git_push
  mode            String   @default("live") // preview | live
  status          String   @default("draft") // draft | awaiting_approval | ready | running | succeeded | failed | blocked | canceled
  blockedReason   String?  @db.Text
  planHash        String?
  inputSnapshot   Json?
  createdByUserId String?
  releaseOrderId  String?
  startedAt       DateTime?
  finishedAt      DateTime?
  canceledAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment     ProjectEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("ReleasePlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  releaseOrder    ReleaseOrder? @relation(fields: [releaseOrderId], references: [id], onDelete: SetNull)
  releaseRuns     ReleaseRun[]
  stages          ReleaseStage[]
  events          ReleaseEvent[]

  @@index([teamId])
  @@index([projectId])
  @@index([environmentId])
  @@index([createdByUserId])
  @@index([releaseOrderId])
  @@index([status])
  @@index([planHash])
  @@index([mode])
  @@index([startedAt])
}

// 发布计划中的不可变阶段节点（F383）
model ReleaseStage {
  id                  String   @id @default(cuid())
  releasePlanId       String
  teamId              String
  key                 String
  name                String
  type                String // precheck | schema_migration | bootstrap | data_backfill | application_deploy | health_check | manual_gate | custom_command
  applicationId       String?
  applicationServiceId String?
  environmentId       String?
  serverId            String?
  executorKind        String // server_command | deployment_run | manual_gate | shell
  configSnapshot      Json?
  configHash          String?
  outputSchema        Json?
  idempotencyKey      String?
  concurrencyKey      String?
  riskLevel           String   @default("low") // low | medium | high
  required            Boolean  @default(true)
  status              String   @default("pending") // pending | blocked | awaiting_approval | ready | queued | running | succeeded | failed | skipped | canceled
  blockedReason       String?  @db.Text
  currentAttempt      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  releasePlan         ReleasePlan @relation(fields: [releasePlanId], references: [id], onDelete: Cascade)
  team                Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  application         Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationService  ApplicationService? @relation(fields: [applicationServiceId], references: [id], onDelete: SetNull)
  environment         ProjectEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  attempts            ReleaseStageAttempt[]
  dependencies        ReleaseStageDependency[] @relation("ReleaseStageDependent")
  dependents          ReleaseStageDependency[] @relation("ReleaseStageDependsOn")
  events              ReleaseEvent[]
  concurrencyLeases   ReleaseConcurrencyLease[]

  @@unique([releasePlanId, key], map: "release_stage_plan_key")
  @@index([teamId])
  @@index([releasePlanId])
  @@index([applicationId])
  @@index([applicationServiceId])
  @@index([environmentId])
  @@index([serverId])
  @@index([type])
  @@index([executorKind])
  @@index([status])
  @@index([idempotencyKey])
  @@index([concurrencyKey])
}

// 阶段依赖边（F383）
model ReleaseStageDependency {
  id               String   @id @default(cuid())
  stageId          String
  dependsOnStageId String
  conditionType    String   // succeeded | completed | output_match | approved
  conditionSnapshot Json?
  createdAt        DateTime @default(now())

  stage            ReleaseStage @relation("ReleaseStageDependent", fields: [stageId], references: [id], onDelete: Cascade)
  dependsOnStage   ReleaseStage @relation("ReleaseStageDependsOn", fields: [dependsOnStageId], references: [id], onDelete: Cascade)

  @@unique([stageId, dependsOnStageId], map: "release_stage_dependency_pair")
  @@index([stageId])
  @@index([dependsOnStageId])
  @@index([conditionType])
}

// 阶段每次执行尝试的不可变证据（F383）
model ReleaseStageAttempt {
  id                   String   @id @default(cuid())
  releaseStageId       String
  teamId               String
  attemptNo            Int
  status               String   @default("queued") // queued | running | succeeded | failed | skipped | canceled
  deploymentRunId      String?
  serverExecutionJobId String?
  operationApprovalId  String?
  buildRunId           String?  @unique
  releaseRunId         String?  @unique
  inputSnapshot        Json?
  output               Json?
  logSummary           Json?
  error                String?  @db.Text
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  heartbeatAt          DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  releaseStage         ReleaseStage @relation(fields: [releaseStageId], references: [id], onDelete: Cascade)
  team                 Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deploymentRun        DeploymentRun? @relation(fields: [deploymentRunId], references: [id], onDelete: SetNull)
  serverExecutionJob   ServerExecutionJob? @relation(fields: [serverExecutionJobId], references: [id], onDelete: SetNull)
  operationApproval    OperationApproval? @relation("OperationApprovalReleaseAttempt", fields: [operationApprovalId], references: [id], onDelete: SetNull)
  buildRun             BuildRun? @relation(fields: [buildRunId], references: [id], onDelete: SetNull)
  releaseRun           ReleaseRun? @relation(fields: [releaseRunId], references: [id], onDelete: SetNull)
  events               ReleaseEvent[]

  @@unique([releaseStageId, attemptNo], map: "release_stage_attempt_no")
  @@index([teamId])
  @@index([releaseStageId])
  @@index([deploymentRunId])
  @@index([serverExecutionJobId])
  @@index([operationApprovalId])
  @@index([status])
  @@index([leaseOwner])
  @@index([leaseExpiresAt])
}

// 并发键租约：用唯一键原子保证同一 concurrencyKey 同时只能有一个活跃阶段（F383 D2）
model ReleaseConcurrencyLease {
  id             String   @id @default(cuid())
  concurrencyKey String
  releaseStageId String
  attemptId      String
  owner          String
  acquiredAt     DateTime @default(now())
  expiresAt      DateTime
  heartbeatAt    DateTime?
  releaseStage   ReleaseStage @relation(fields: [releaseStageId], references: [id], onDelete: Cascade)

  @@unique([concurrencyKey], map: "release_concurrency_lease_key")
  @@index([releaseStageId])
  @@index([expiresAt])
  @@index([owner])
}

// 发布级统一时间线（只追加，F383）
model ReleaseEvent {
  id               String   @id @default(cuid())
  releasePlanId    String
  releaseStageId   String?
  stageAttemptId   String?
  teamId           String
  eventType        String
  actorType        String   @default("system") // system | user | scheduler
  actorId          String?
  correlationId    String?
  summary          String?  @db.Text
  metadata         Json?
  createdAt        DateTime @default(now())

  releasePlan      ReleasePlan @relation(fields: [releasePlanId], references: [id], onDelete: Cascade)
  team             Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  releaseStage     ReleaseStage? @relation(fields: [releaseStageId], references: [id], onDelete: Cascade)
  stageAttempt     ReleaseStageAttempt? @relation(fields: [stageAttemptId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([releasePlanId])
  @@index([releaseStageId])
  @@index([stageAttemptId])
  @@index([eventType])
  @@index([actorId])
  @@index([correlationId])
  @@index([createdAt])
}
