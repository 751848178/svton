[Unit]
Description=Devpilot trusted external OCI release-build launcher
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/devpilot/current
EnvironmentFile=/etc/devpilot/release-build-launcher.env
ExecStart=/opt/devpilot/current/scripts/devpilot/run-release-build-external-oci-launcher.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=180
SendSIGKILL=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/devpilot/release-build-launcher /run/devpilot
UMask=0077

[Install]
WantedBy=multi-user.target
